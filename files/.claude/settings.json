{
  "permissions": {
    "allow": [
      "Bash(rm /var/folders/78/h841hq3n2c5f6087ks28v2240000gn/T/no-mistakes-evidence/:*)",
      "Bash(rm -f /var/folders/78/h841hq3n2c5f6087ks28v2240000gn/T/no-mistakes-evidence/:*)",
      "Bash(rm -r /var/folders/78/h841hq3n2c5f6087ks28v2240000gn/T/no-mistakes-evidence/:*)",
      "Bash(rm -rf /var/folders/78/h841hq3n2c5f6087ks28v2240000gn/T/no-mistakes-evidence/:*)",
      "Bash(rm /tmp/no-mistakes-evidence/:*)",
      "Bash(rm -f /tmp/no-mistakes-evidence/:*)",
      "Bash(rm -r /tmp/no-mistakes-evidence/:*)",
      "Bash(rm -rf /tmp/no-mistakes-evidence/:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(unlink:*)",
      "Bash(trash:*)",
      "Bash(git clean:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "c=$(git -C \"$PWD\" stash create \"pre-compaction checkpoint\" 2>/dev/null) && [ -n \"$c\" ] && git -C \"$PWD\" stash store -m \"auto-save: pre-compaction $(date -u +%FT%TZ)\" \"$c\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "chrome-devtools-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "lavish-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "tasks-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "caveman-activate",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/allan/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "caveman-mode-tracker",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi"
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "sentry@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "theme": "dark-daltonized",
  "skipDangerousModePermissionPrompt": true
}
